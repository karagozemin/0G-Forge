# 0G Chain deployment
OG_PRIVATE_KEY=your_wallet_private_key_here

# CLI sync (`og sync`) uses 0G MAINNET defaults; the registry contract below
# only exists on mainnet. Set OG_EVM_RPC explicitly only if you need to
# override the default https://evmrpc.0g.ai.

# Testnet (Galileo)
OG_EVM_RPC_TESTNET=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_RPC_TESTNET=https://indexer-storage-testnet-standard.0g.ai

# Mainnet
OG_EVM_RPC_MAINNET=https://evmrpc.0g.ai
OG_STORAGE_INDEXER_RPC_MAINNET=https://indexer-storage-turbo.0g.ai

# After deployment, copy the contract address here
OG_REGISTRY_CONTRACT=0x47955e005433A548287358c4DFd6679A0e8F5d50
